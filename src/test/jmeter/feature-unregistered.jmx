            <collectionProp name="Arguments.arguments"/>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="RegEx - Location Header (Auth URL)">
            <stringProp name="RegexExtractor.useHeaders">true</stringProp>
            <stringProp name="RegexExtractor.refname">authUrl</stringProp>
            <stringProp name="RegexExtractor.regex">location: (.*)</stringProp>
            <stringProp name="RegexExtractor.template">$1$</stringProp>
            <stringProp name="RegexExtractor.default">NO_AUTH_URL</stringProp>
            <boolProp name="RegexExtractor.default_empty_value">false</boolProp>
            <stringProp name="RegexExtractor.match_number">1</stringProp>
          </RegexExtractor>
          <hashTree/>
          <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="RegEx - OIDC State">
            <stringProp name="RegexExtractor.useHeaders">true</stringProp>
            <stringProp name="RegexExtractor.refname">state</stringProp>
            <stringProp name="RegexExtractor.regex">state=([\w\.\-]+)</stringProp>
            <stringProp name="RegexExtractor.template">$1$</stringProp>
            <stringProp name="RegexExtractor.default">NO_STATE</stringProp>
            <boolProp name="RegexExtractor.default_empty_value">false</boolProp>
            <stringProp name="RegexExtractor.match_number"></stringProp>
          </RegexExtractor>
          <hashTree/>
          <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="RegEx - Redirect URI (Raw)">
            <stringProp name="RegexExtractor.useHeaders">true</stringProp>
            <stringProp name="RegexExtractor.refname">redirectUriEncoded</stringProp>
            <stringProp name="RegexExtractor.regex">redirect_uri=([^&amp;]+)</stringProp>
            <stringProp name="RegexExtractor.template">$1$</stringProp>
            <stringProp name="RegexExtractor.default">NOT_FOUND</stringProp>
            <boolProp name="RegexExtractor.default_empty_value">false</boolProp>
            <stringProp name="RegexExtractor.match_number">1</stringProp>
            <stringProp name="Sample.scope">all</stringProp>
          </RegexExtractor>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 - Decode URI">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import java.net.URLDecoder;

String encoded = vars.get(&quot;redirectUriEncoded&quot;);

if (encoded != null &amp;&amp; !encoded.equals(&quot;NOT_FOUND&quot;)) {
    String decoded = URLDecoder.decode(encoded, &quot;UTF-8&quot;);
    vars.put(&quot;redirectUri&quot;, decoded);
    log.info(&quot;Decoded Redirect URI: &quot; + decoded);
}

def cookieList = []
def lbCookie = &quot;&quot;
def headers = prev.getResponseHeaders().split(&quot;\n&quot;)

for (String header : headers) {
    if (header.toLowerCase().startsWith(&quot;set-cookie:&quot;)) {
        def matcher = (header =~ /(?i)set-cookie:\s*([^;\r\n]+)/)
        if (matcher.find()) {
            def cookieVal = matcher.group(1).trim()
            cookieList.add(cookieVal)
            
            // Якщо кука не починається з &quot;session=&quot;, значить це Sticky Session балансувальника
            if (!cookieVal.toLowerCase().startsWith(&quot;session=&quot;)) {
                lbCookie = cookieVal
                vars.put(&quot;lbCookie&quot;, lbCookie)
                log.info(&quot;=== Збережено куку балансувальника: &quot; + lbCookie)
            }
        }
    }
}

if (cookieList.size() &gt; 0) {
    vars.put(&quot;allPortalCookies&quot;, cookieList.join(&quot;; &quot;))
}</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
          <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="Regular Expression Extractor">
            <stringProp name="RegexExtractor.useHeaders">true</stringProp>
            <stringProp name="RegexExtractor.refname">portalSession</stringProp>
            <stringProp name="RegexExtractor.regex">session=([^;]+)</stringProp>
            <stringProp name="RegexExtractor.template">$1$</stringProp>
            <stringProp name="RegexExtractor.default">NO_SESSION</stringProp>
            <boolProp name="RegexExtractor.default_empty_value">false</boolProp>
            <stringProp name="RegexExtractor.match_number"></stringProp>
            <stringProp name="Sample.scope">all</stringProp>
          </RegexExtractor>
