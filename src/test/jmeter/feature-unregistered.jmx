          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 - Clear Cookie">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">if (sampler.getCookieManager() != null) {
    sampler.getCookieManager().clear()
    log.info(&quot;=== [SESSION CLEAR] HTTP Cookie Manager очищено ===&quot;)
} else {
    log.warn(&quot;Cookie Manager не знайдено у цьому запиті!&quot;)
}

if (sampler.getCacheManager() != null) {
    sampler.getCacheManager().clear()
    log.info(&quot;=== [SESSION CLEAR] HTTP Cache Manager очищено ===&quot;)
}

vars.remove(&quot;xsrfToken&quot;)
vars.remove(&quot;authUrl&quot;)
vars.remove(&quot;state&quot;)
vars.remove(&quot;redirectUriEncoded&quot;)
vars.remove(&quot;redirectUri&quot;)
vars.remove(&quot;loginAction&quot;)
vars.remove(&quot;authCode&quot;)
vars.remove(&quot;portalSession&quot;)
vars.remove(&quot;allPortalCookies&quot;)
vars.remove(&quot;lbCookie&quot;)

log.info(&quot;=== [SESSION CLEAR] Змінні авторизації видалено. Готові до логіну Провайдера. ===&quot;)</stringProp>
          </JSR223PostProcessor>
