          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Create payload" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonOutput

def formData = extractVar(&apos;formData&apos;)?.data
log.info(&apos;formData={}&apos;, formData)

def payload = [:]
payload.data = formData
payload.signature = &quot;${vars.get(&apos;userName&apos;)}.dat&quot;
vars.put(&apos;payload&apos;, JsonOutput.toJson(payload))
log.info(&quot;Payload={}&quot;, JsonOutput.toJson(payload))

def extractVar(String varName) {
	def tmp = vars.get(varName)
	if (tmp == &apos;NOT_FOUND&apos;) return null
	log.info(&apos;{}={}&apos;, varName, tmp)
	def slurp = props.get(&apos;slurp&apos;)
	return slurp(tmp)
}
SampleResult.setIgnore()</stringProp>
