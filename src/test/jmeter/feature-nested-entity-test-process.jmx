              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import org.apache.jmeter.protocol.http.control.CookieManager

CookieManager manager = sampler.getCookieManager()
if (manager != null) {
    for (int i = 0; i &lt; manager.getCookieCount(); i++) {
        if (manager.get(i).getName().equals(&quot;XSRF-TOKEN&quot;)) {
            def latestToken = manager.get(i).getValue()
            vars.put(&quot;xsrfToken&quot;, latestToken)
            log.info(&quot;=== [XSRF SYNC] Оновлено токен із Cookie Manager: &quot; + latestToken)
            break
        }
    }
} else {
    log.warn(&quot;Cookie Manager не знайдено!&quot;)
}</stringProp>
