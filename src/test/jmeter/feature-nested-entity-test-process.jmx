          <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="Extract XSRF" enabled="true">
            <stringProp name="RegexExtractor.useHeaders">true</stringProp>
            <stringProp name="RegexExtractor.refname">xsrfToken</stringProp>
            <stringProp name="RegexExtractor.regex">XSRF-TOKEN=([^;\r\n]+)</stringProp>
            <stringProp name="RegexExtractor.template">$1$</stringProp>
            <stringProp name="RegexExtractor.default">NO_TOKEN</stringProp>
            <boolProp name="RegexExtractor.default_empty_value">false</boolProp>
            <stringProp name="RegexExtractor.match_number">1</stringProp>
            <stringProp name="Sample.scope">all</stringProp>
          </RegexExtractor>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import org.apache.jmeter.protocol.http.control.Cookie
import org.apache.jmeter.protocol.http.control.CookieManager
import java.time.Instant
import java.time.temporal.ChronoUnit

def xsrf = vars.get(&quot;xsrfToken&quot;)

if(xsrf != null &amp;&amp; xsrf != &quot;NO_TOKEN&quot; &amp;&amp; xsrf != &quot;EMPTY&quot;) {
    long futureExpiry = Instant.now().plus(1, ChronoUnit.HOURS).getEpochSecond()
    def cookie = new Cookie(&quot;XSRF-TOKEN&quot;, xsrf, vars.get(&quot;host&quot;), &quot;/&quot;, true, futureExpiry)
    
    // Спробуємо отримати CookieManager з поточного запиту
    def cookieManager = sampler.getCookieManager()
    
    // Якщо його немає в запиті, беремо його з потоку (Thread Context)
    if (cookieManager == null) {
        cookieManager = ctx.getCurrentSampler().getCookieManager()
    }
    
    // Якщо ми його знайшли — додаємо куку
    if (cookieManager != null) {
        cookieManager.add(cookie)
        log.info(&quot;=== [COOKIE MANAGER] XSRF-TOKEN додано успішно: &quot; + xsrf)
    } else {
        log.warn(&quot;=== [УВАГА] Cookie Manager не знайдено навіть у контексті потоку!&quot;)
        // Якщо менеджера немає, просто зберігаємо в змінну
    }
}</stringProp>
          </JSR223PostProcessor>
